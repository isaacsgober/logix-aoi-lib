<Routine Name="MainRoutine" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[JSR(TestDriver, 0);]]>
</Line>
<Line Number="1">
<![CDATA[JSR(Harness, 0);]]>
</Line>
</STContent>
</Routine>
<Routine Name="TestDriver" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[TimeCues(Cue, CaseTimer.ACC);]]>
</Line>
<Line Number="1">
<![CDATA[CASE DriverStep OF]]>
</Line>
<Line Number="2">
<![CDATA[	0:]]>
</Line>
<Line Number="3">
<![CDATA[		IF DriverRun THEN]]>
</Line>
<Line Number="4">
<![CDATA[			CaseIndex := 0;]]>
</Line>
<Line Number="5">
<![CDATA[			FOR i := 0 TO 23 DO]]>
</Line>
<Line Number="6">
<![CDATA[				FailTime[i] := 0;]]>
</Line>
<Line Number="7">
<![CDATA[			END_FOR;]]>
</Line>
<Line Number="8">
<![CDATA[			DriverStep := 10;]]>
</Line>
<Line Number="9">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="10">
<![CDATA[	10:]]>
</Line>
<Line Number="11">
<![CDATA[		TestMode := 0;]]>
</Line>
<Line Number="12">
<![CDATA[		DriverStep := 20;]]>
</Line>
<Line Number="13">
<![CDATA[	20:]]>
</Line>
<Line Number="14">
<![CDATA[		TestMode := CaseList[CaseIndex];]]>
</Line>
<Line Number="15">
<![CDATA[		DriverStep := 30;]]>
</Line>
<Line Number="16">
<![CDATA[	30:]]>
</Line>
<Line Number="17">
<![CDATA[		ResetButton := 0;]]>
</Line>
<Line Number="18">
<![CDATA[		NoFaults := NOT (TestActuator.TimeoutFault OR TestActuator.SensorFault OR TestActuator.ParamFault);]]>
</Line>
<Line Number="19">
<![CDATA[		FailNow := 0;]]>
</Line>
<Line Number="20">
<![CDATA[		IF ((TestMode = 901) OR (TestMode = 902)) THEN]]>
</Line>
<Line Number="21">
<![CDATA[			IF Cue.T20 AND NOT TestActuator.ParamFault THEN]]>
</Line>
<Line Number="22">
<![CDATA[				FailNow := 20;]]>
</Line>
<Line Number="23">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="24">
<![CDATA[		ELSE]]>
</Line>
<Line Number="25">
<![CDATA[			CASE TestCase OF]]>
</Line>
<Line Number="26">
<![CDATA[				1: //At position 0]]>
</Line>
<Line Number="27">
<![CDATA[					IF Cue.T50 AND NOT (TestActuator.AtPos0 AND TestActuator.Drive0 AND NoFaults) THEN]]>
</Line>
<Line Number="28">
<![CDATA[						FailNow := 50;]]>
</Line>
<Line Number="29">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="30">
<![CDATA[					IF Cue.T200 AND NOT NoFaults THEN]]>
</Line>
<Line Number="31">
<![CDATA[						FailNow := 200;]]>
</Line>
<Line Number="32">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="33">
<![CDATA[				2: //Move to position 1]]>
</Line>
<Line Number="34">
<![CDATA[					IF Cue.T50 THEN]]>
</Line>
<Line Number="35">
<![CDATA[						Sensor0 := 0;]]>
</Line>
<Line Number="36">
<![CDATA[						Sensor1 := 1;]]>
</Line>
<Line Number="37">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="38">
<![CDATA[					IF Cue.T80 AND NOT (TestActuator.AtPos1 AND TestActuator.Drive1 AND NoFaults) THEN]]>
</Line>
<Line Number="39">
<![CDATA[						FailNow := 80;]]>
</Line>
<Line Number="40">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="41">
<![CDATA[					IF Cue.T200 AND NOT NoFaults THEN]]>
</Line>
<Line Number="42">
<![CDATA[						FailNow := 200;]]>
</Line>
<Line Number="43">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="44">
<![CDATA[				3: //Timeout]]>
</Line>
<Line Number="45">
<![CDATA[					IF Cue.T50 AND NOT NoFaults THEN]]>
</Line>
<Line Number="46">
<![CDATA[						FailNow := 50;]]>
</Line>
<Line Number="47">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="48">
<![CDATA[					IF Cue.T150 AND NOT (TestActuator.TimeoutFault AND TestActuator.Drive0) THEN]]>
</Line>
<Line Number="49">
<![CDATA[						FailNow := 150;]]>
</Line>
<Line Number="50">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="51">
<![CDATA[				4: //Timeout, Deactivate on Fault]]>
</Line>
<Line Number="52">
<![CDATA[					IF Cue.T150 AND NOT (TestActuator.TimeoutFault AND NOT (TestActuator.Drive0 OR TestActuator.Drive1)) THEN]]>
</Line>
<Line Number="53">
<![CDATA[						FailNow := 150;]]>
</Line>
<Line Number="54">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="55">
<![CDATA[				5: //Reset retries]]>
</Line>
<Line Number="56">
<![CDATA[					IF Cue.T150 THEN]]>
</Line>
<Line Number="57">
<![CDATA[						ResetButton := 1;]]>
</Line>
<Line Number="58">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="59">
<![CDATA[					IF Cue.T120 AND NOT TestActuator.TimeoutFault THEN]]>
</Line>
<Line Number="60">
<![CDATA[						FailNow := 120;]]>
</Line>
<Line Number="61">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="62">
<![CDATA[					IF Cue.T200 AND NOT NoFaults THEN]]>
</Line>
<Line Number="63">
<![CDATA[						FailNow := 200;]]>
</Line>
<Line Number="64">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="65">
<![CDATA[					IF Cue.T300 AND NOT TestActuator.TimeoutFault THEN]]>
</Line>
<Line Number="66">
<![CDATA[						FailNow := 300;]]>
</Line>
<Line Number="67">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="68">
<![CDATA[				6: //Reset then arrive]]>
</Line>
<Line Number="69">
<![CDATA[					IF Cue.T150 THEN]]>
</Line>
<Line Number="70">
<![CDATA[						ResetButton := 1;]]>
</Line>
<Line Number="71">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="72">
<![CDATA[					IF Cue.T200 THEN]]>
</Line>
<Line Number="73">
<![CDATA[						Sensor0 := 1;]]>
</Line>
<Line Number="74">
<![CDATA[						Sensor1 := 0;]]>
</Line>
<Line Number="75">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="76">
<![CDATA[					IF Cue.T120 AND NOT TestActuator.TimeoutFault THEN]]>
</Line>
<Line Number="77">
<![CDATA[						FailNow := 120;]]>
</Line>
<Line Number="78">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="79">
<![CDATA[					IF Cue.T300 AND NOT (NoFaults AND TestActuator.AtPos0) THEN]]>
</Line>
<Line Number="80">
<![CDATA[						FailNow := 300;]]>
</Line>
<Line Number="81">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="82">
<![CDATA[				7: //Timer restarts on Cmd change]]>
</Line>
<Line Number="83">
<![CDATA[					IF Cue.T60 THEN]]>
</Line>
<Line Number="84">
<![CDATA[						Command := 0;]]>
</Line>
<Line Number="85">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="86">
<![CDATA[					IF Cue.T120 AND NOT NoFaults THEN]]>
</Line>
<Line Number="87">
<![CDATA[						FailNow := 120;]]>
</Line>
<Line Number="88">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="89">
<![CDATA[					IF Cue.T200 AND NOT TestActuator.TimeoutFault THEN]]>
</Line>
<Line Number="90">
<![CDATA[						FailNow := 200;]]>
</Line>
<Line Number="91">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="92">
<![CDATA[				8: //Lost position]]>
</Line>
<Line Number="93">
<![CDATA[					IF Cue.T50 THEN]]>
</Line>
<Line Number="94">
<![CDATA[						Sensor1 := 0;]]>
</Line>
<Line Number="95">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="96">
<![CDATA[					IF Cue.T40 AND NOT TestActuator.AtPos1 THEN]]>
</Line>
<Line Number="97">
<![CDATA[						FailNow := 40;]]>
</Line>
<Line Number="98">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="99">
<![CDATA[					IF Cue.T120 AND NOT NoFaults THEN]]>
</Line>
<Line Number="100">
<![CDATA[						FailNow := 120;]]>
</Line>
<Line Number="101">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="102">
<![CDATA[					IF Cue.T200 AND NOT TestActuator.TimeoutFault THEN]]>
</Line>
<Line Number="103">
<![CDATA[						FailNow := 200;]]>
</Line>
<Line Number="104">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="105">
<![CDATA[				9: //Both sensors on]]>
</Line>
<Line Number="106">
<![CDATA[					IF Cue.T20 AND NOT TestActuator.SensorFault THEN]]>
</Line>
<Line Number="107">
<![CDATA[						FailNow := 20;]]>
</Line>
<Line Number="108">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="109">
<![CDATA[					IF Cue.T150 AND NOT TestActuator.TimeoutFault THEN]]>
</Line>
<Line Number="110">
<![CDATA[						FailNow := 150;]]>
</Line>
<Line Number="111">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="112">
<![CDATA[				10: //Sensor fault reset]]>
</Line>
<Line Number="113">
<![CDATA[					IF Cue.T20 THEN]]>
</Line>
<Line Number="114">
<![CDATA[						ResetButton := 1;]]>
</Line>
<Line Number="115">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="116">
<![CDATA[					IF Cue.T40 THEN]]>
</Line>
<Line Number="117">
<![CDATA[						Sensor1 := 0;]]>
</Line>
<Line Number="118">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="119">
<![CDATA[					IF Cue.T50 THEN]]>
</Line>
<Line Number="120">
<![CDATA[						ResetButton := 1;]]>
</Line>
<Line Number="121">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="122">
<![CDATA[					IF Cue.T30 AND NOT TestActuator.SensorFault THEN]]>
</Line>
<Line Number="123">
<![CDATA[						FailNow := 30;]]>
</Line>
<Line Number="124">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="125">
<![CDATA[					IF Cue.T60 AND NOT NoFaults THEN]]>
</Line>
<Line Number="126">
<![CDATA[						FailNow := 60;]]>
</Line>
<Line Number="127">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="128">
<![CDATA[				11: //Stop command]]>
</Line>
<Line Number="129">
<![CDATA[					IF Cue.T20 THEN]]>
</Line>
<Line Number="130">
<![CDATA[						IF TestDriveType = 2 THEN]]>
</Line>
<Line Number="131">
<![CDATA[							IF NOT (NoFaults AND NOT (TestActuator.Drive0 OR TestActuator.Drive1)) THEN]]>
</Line>
<Line Number="132">
<![CDATA[								FailNow := 20;]]>
</Line>
<Line Number="133">
<![CDATA[							END_IF;]]>
</Line>
<Line Number="134">
<![CDATA[						ELSIF NOT TestActuator.ParamFault THEN]]>
</Line>
<Line Number="135">
<![CDATA[							FailNow := 20;]]>
</Line>
<Line Number="136">
<![CDATA[						END_IF;]]>
</Line>
<Line Number="137">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="138">
<![CDATA[					IF Cue.T150 AND (TestDriveType = 2) AND NOT NoFaults THEN]]>
</Line>
<Line Number="139">
<![CDATA[						FailNow := 150;]]>
</Line>
<Line Number="140">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="141">
<![CDATA[				12: //Cmd out of range]]>
</Line>
<Line Number="142">
<![CDATA[					IF Cue.T20 AND NOT TestActuator.ParamFault THEN]]>
</Line>
<Line Number="143">
<![CDATA[						FailNow := 20;]]>
</Line>
<Line Number="144">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="145">
<![CDATA[				13: //Negative Timeout0]]>
</Line>
<Line Number="146">
<![CDATA[					IF Cue.T20 AND NOT TestActuator.ParamFault THEN]]>
</Line>
<Line Number="147">
<![CDATA[						FailNow := 20;]]>
</Line>
<Line Number="148">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="149">
<![CDATA[				14: //Negative Timeout1]]>
</Line>
<Line Number="150">
<![CDATA[					IF Cue.T20 AND NOT TestActuator.ParamFault THEN]]>
</Line>
<Line Number="151">
<![CDATA[						FailNow := 20;]]>
</Line>
<Line Number="152">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="153">
<![CDATA[				15: //Stop, then move]]>
</Line>
<Line Number="154">
<![CDATA[					IF Cue.T50 THEN]]>
</Line>
<Line Number="155">
<![CDATA[						Command := 1;]]>
</Line>
<Line Number="156">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="157">
<![CDATA[					IF Cue.T60 AND NOT TestActuator.Drive1 THEN]]>
</Line>
<Line Number="158">
<![CDATA[						FailNow := 60;]]>
</Line>
<Line Number="159">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="160">
<![CDATA[					IF Cue.T200 AND NOT TestActuator.TimeoutFault THEN]]>
</Line>
<Line Number="161">
<![CDATA[						FailNow := 200;]]>
</Line>
<Line Number="162">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="163">
<![CDATA[				16: //At position 1]]>
</Line>
<Line Number="164">
<![CDATA[					IF Cue.T50 AND NOT (TestActuator.AtPos1 AND TestActuator.Drive1 AND NoFaults) THEN]]>
</Line>
<Line Number="165">
<![CDATA[						FailNow := 50;]]>
</Line>
<Line Number="166">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="167">
<![CDATA[					IF Cue.T200 AND NOT NoFaults THEN]]>
</Line>
<Line Number="168">
<![CDATA[						FailNow := 200;]]>
</Line>
<Line Number="169">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="170">
<![CDATA[				17: //Move to position 0]]>
</Line>
<Line Number="171">
<![CDATA[					IF Cue.T50 THEN]]>
</Line>
<Line Number="172">
<![CDATA[						Sensor0 := 1;]]>
</Line>
<Line Number="173">
<![CDATA[						Sensor1 := 0;]]>
</Line>
<Line Number="174">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="175">
<![CDATA[					IF Cue.T80 AND NOT (TestActuator.AtPos0 AND TestActuator.Drive0 AND NoFaults) THEN]]>
</Line>
<Line Number="176">
<![CDATA[						FailNow := 80;]]>
</Line>
<Line Number="177">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="178">
<![CDATA[					IF Cue.T200 AND NOT NoFaults THEN]]>
</Line>
<Line Number="179">
<![CDATA[						FailNow := 200;]]>
</Line>
<Line Number="180">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="181">
<![CDATA[				18: //Cmd 0 uses Timeout0]]>
</Line>
<Line Number="182">
<![CDATA[					IF Cue.T150 AND NOT TestActuator.TimeoutFault THEN]]>
</Line>
<Line Number="183">
<![CDATA[						FailNow := 150;]]>
</Line>
<Line Number="184">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="185">
<![CDATA[				19: //Cmd 1 uses Timeout1]]>
</Line>
<Line Number="186">
<![CDATA[					IF Cue.T150 AND NOT TestActuator.TimeoutFault THEN]]>
</Line>
<Line Number="187">
<![CDATA[						FailNow := 150;]]>
</Line>
<Line Number="188">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="189">
<![CDATA[			END_CASE;]]>
</Line>
<Line Number="190">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="191">
<![CDATA[]]>
</Line>
<Line Number="192">
<![CDATA[		IF ((FailNow > 0) AND (FailTime[CaseIndex] = 0)) THEN]]>
</Line>
<Line Number="193">
<![CDATA[			FailTime[CaseIndex] := FailNow;]]>
</Line>
<Line Number="194">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="195">
<![CDATA[				]]>
</Line>
<Line Number="196">
<![CDATA[		IF CaseTimer.ACC >= 400 THEN]]>
</Line>
<Line Number="197">
<![CDATA[			CaseIndex := CaseIndex + 1;]]>
</Line>
<Line Number="198">
<![CDATA[			IF CaseIndex > 23 THEN]]>
</Line>
<Line Number="199">
<![CDATA[				DriverRun := 0;]]>
</Line>
<Line Number="200">
<![CDATA[				DriverStep := 0;]]>
</Line>
<Line Number="201">
<![CDATA[			ELSE]]>
</Line>
<Line Number="202">
<![CDATA[				DriverStep := 10;]]>
</Line>
<Line Number="203">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="204">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="205">
<![CDATA[END_CASE;]]>
</Line>
<Line Number="206">
<![CDATA[			]]>
</Line>
<Line Number="207">
<![CDATA[CaseTimer.PRE := 1000;]]>
</Line>
<Line Number="208">
<![CDATA[CaseTimer.TimerEnable := (DriverStep = 30);]]>
</Line>
<Line Number="209">
<![CDATA[TONR(CaseTimer);]]>
</Line>
<Line Number="210">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
</Programs>
