</Line>
<Line Number="49">
<![CDATA[			Command := 0;]]>
</Line>
<Line Number="50">
<![CDATA[			Sensor0 := 0;]]>
</Line>
<Line Number="51">
<![CDATA[			Sensor1 := 1;]]>
</Line>
<Line Number="52">
<![CDATA[			TestDeactivate := 0;]]>
</Line>
<Line Number="53">
<![CDATA[			Timeout0 := 100;]]>
</Line>
<Line Number="54">
<![CDATA[			Timeout1 := 100;]]>
</Line>
<Line Number="55">
<![CDATA[		7: //Timer restarts on Cmd change]]>
</Line>
<Line Number="56">
<![CDATA[			Command := 1;]]>
</Line>
<Line Number="57">
<![CDATA[			Sensor0 := 0;]]>
</Line>
<Line Number="58">
<![CDATA[			Sensor1 := 0;]]>
</Line>
<Line Number="59">
<![CDATA[			TestDeactivate := 0;]]>
</Line>
<Line Number="60">
<![CDATA[			Timeout0 := 100;]]>
</Line>
<Line Number="61">
<![CDATA[			Timeout1 := 100;]]>
</Line>
<Line Number="62">
<![CDATA[		8: //Lost position]]>
</Line>
<Line Number="63">
<![CDATA[			Command := 1;]]>
</Line>
<Line Number="64">
<![CDATA[			Sensor0 := 0;]]>
</Line>
<Line Number="65">
<![CDATA[			Sensor1 := 1;]]>
</Line>
<Line Number="66">
<![CDATA[			TestDeactivate := 0;]]>
</Line>
<Line Number="67">
<![CDATA[			Timeout0 := 100;]]>
</Line>
<Line Number="68">
<![CDATA[			Timeout1 := 100;]]>
</Line>
<Line Number="69">
<![CDATA[		9: //Both sensors on]]>
</Line>
<Line Number="70">
<![CDATA[			Command := 0;]]>
</Line>
<Line Number="71">
<![CDATA[			Sensor0 := 1;]]>
</Line>
<Line Number="72">
<![CDATA[			Sensor1 := 1;]]>
</Line>
<Line Number="73">
<![CDATA[			TestDeactivate := 0;]]>
</Line>
<Line Number="74">
<![CDATA[			Timeout0 := 100;]]>
</Line>
<Line Number="75">
<![CDATA[			Timeout1 := 100;]]>
</Line>
<Line Number="76">
<![CDATA[		10: //Sensor fault reset]]>
</Line>
<Line Number="77">
<![CDATA[			Command := 0;]]>
</Line>
<Line Number="78">
<![CDATA[			Sensor0 := 1;]]>
</Line>
<Line Number="79">
<![CDATA[			Sensor1 := 1;]]>
</Line>
<Line Number="80">
<![CDATA[			TestDeactivate := 0;]]>
</Line>
<Line Number="81">
<![CDATA[			Timeout0 := 100;]]>
</Line>
<Line Number="82">
<![CDATA[			Timeout1 := 100;]]>
</Line>
<Line Number="83">
<![CDATA[		11: //Stop command]]>
</Line>
<Line Number="84">
<![CDATA[			Command := 2;]]>
</Line>
<Line Number="85">
<![CDATA[			Sensor0 := 0;]]>
</Line>
<Line Number="86">
<![CDATA[			Sensor1 := 0;]]>
</Line>
<Line Number="87">
<![CDATA[			TestDeactivate := 0;]]>
</Line>
<Line Number="88">
<![CDATA[			Timeout0 := 100;]]>
</Line>
<Line Number="89">
<![CDATA[			Timeout1 := 100;]]>
</Line>
<Line Number="90">
<![CDATA[		12: //Cmd out of range]]>
</Line>
<Line Number="91">
<![CDATA[			Command := 5;]]>
</Line>
<Line Number="92">
<![CDATA[			Sensor0 := 0;]]>
</Line>
<Line Number="93">
<![CDATA[			Sensor1 := 0;]]>
</Line>
<Line Number="94">
<![CDATA[			TestDeactivate := 0;]]>
</Line>
<Line Number="95">
<![CDATA[			Timeout0 := 100;]]>
</Line>
<Line Number="96">
<![CDATA[			Timeout1 := 100;]]>
</Line>
<Line Number="97">
<![CDATA[		13: //Negative Timeout0]]>
</Line>
<Line Number="98">
<![CDATA[			Command := 0;]]>
</Line>
<Line Number="99">
<![CDATA[			Sensor0 := 1;]]>
</Line>
<Line Number="100">
<![CDATA[			Sensor1 := 0;]]>
</Line>
<Line Number="101">
<![CDATA[			TestDeactivate := 0;]]>
</Line>
<Line Number="102">
<![CDATA[			Timeout0 := -1;]]>
</Line>
<Line Number="103">
<![CDATA[			Timeout1 := 100;]]>
</Line>
<Line Number="104">
<![CDATA[		14: //Negative Timeout1]]>
</Line>
<Line Number="105">
<![CDATA[			Command := 1;]]>
</Line>
<Line Number="106">
<![CDATA[			Sensor0 := 0;]]>
</Line>
<Line Number="107">
<![CDATA[			Sensor1 := 1;]]>
</Line>
<Line Number="108">
<![CDATA[			TestDeactivate := 0;]]>
</Line>
<Line Number="109">
<![CDATA[			Timeout0 := 100;]]>
</Line>
<Line Number="110">
<![CDATA[			Timeout1 := -1;]]>
</Line>
<Line Number="111">
<![CDATA[		15: //Stop, then move]]>
</Line>
<Line Number="112">
<![CDATA[			Command := 2;]]>
</Line>
<Line Number="113">
<![CDATA[			Sensor0 := 0;]]>
</Line>
<Line Number="114">
<![CDATA[			Sensor1 := 0;]]>
</Line>
<Line Number="115">
<![CDATA[			TestDeactivate := 0;]]>
</Line>
<Line Number="116">
<![CDATA[			Timeout0 := 100;]]>
</Line>
<Line Number="117">
<![CDATA[			Timeout1 := 100;]]>
</Line>
<Line Number="118">
<![CDATA[		16: //At position 1]]>
</Line>
<Line Number="119">
<![CDATA[			Command := 1;]]>
</Line>
<Line Number="120">
<![CDATA[			Sensor0 := 0;]]>
</Line>
<Line Number="121">
<![CDATA[			Sensor1 := 1;]]>
</Line>
<Line Number="122">
<![CDATA[			TestDeactivate := 0;]]>
</Line>
<Line Number="123">
<![CDATA[			Timeout0 := 100;]]>
</Line>
<Line Number="124">
<![CDATA[			Timeout1 := 100;]]>
</Line>
<Line Number="125">
<![CDATA[		17: //Move to position 0]]>
</Line>
<Line Number="126">
<![CDATA[			Command := 0;]]>
</Line>
<Line Number="127">
<![CDATA[			Sensor0 := 0;]]>
</Line>
<Line Number="128">
<![CDATA[			Sensor1 := 1;]]>
</Line>
<Line Number="129">
<![CDATA[			TestDeactivate := 0;]]>
</Line>
<Line Number="130">
<![CDATA[			Timeout0 := 100;]]>
</Line>
<Line Number="131">
<![CDATA[			Timeout1 := 100;]]>
</Line>
<Line Number="132">
<![CDATA[		18: //Cmd 0 uses Timeout0]]>
</Line>
<Line Number="133">
<![CDATA[			Command := 0;]]>
</Line>
<Line Number="134">
<![CDATA[			Sensor0 := 0;]]>
</Line>
<Line Number="135">
<![CDATA[			Sensor1 := 1;]]>
</Line>
<Line Number="136">
<![CDATA[			TestDeactivate := 0;]]>
</Line>
<Line Number="137">
<![CDATA[			Timeout0 := 100;]]>
</Line>
<Line Number="138">
<![CDATA[			Timeout1 := 300;]]>
</Line>
<Line Number="139">
<![CDATA[		19: //Cmd 1 uses Timeout1]]>
</Line>
<Line Number="140">
<![CDATA[			Command := 1;]]>
</Line>
<Line Number="141">
<![CDATA[			Sensor0 := 1;]]>
</Line>
<Line Number="142">
<![CDATA[			Sensor1 := 0;]]>
</Line>
