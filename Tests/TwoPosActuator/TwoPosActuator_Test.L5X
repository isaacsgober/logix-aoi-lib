<Programs>
<Program Name="MainProgram" TestEdits="false" MainRoutineName="MainRoutine" Disabled="false" UseAsFolder="false">
<Tags/>
<Routines>
<Routine Name="Harness" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[TestDriveType := (TestMode / 100);]]>
</Line>
<Line Number="1">
<![CDATA[IF TestMode = 901 THEN]]>
</Line>
<Line Number="2">
<![CDATA[	TestDriveType := -1;]]>
</Line>
<Line Number="3">
<![CDATA[ELSIF TestMode = 902 THEN]]>
</Line>
<Line Number="4">
<![CDATA[	TestDriveType := 3;]]>
</Line>
<Line Number="5">
<![CDATA[END_IF;]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[TestCase := (TestMode MOD 100);]]>
</Line>
<Line Number="8">
<![CDATA[TestReset := ResetButton;]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[IF TestMode <> TestModeStorage THEN // Sets preconditions]]>
</Line>
<Line Number="11">
<![CDATA[	TestReset := 1;]]>
</Line>
<Line Number="12">
<![CDATA[	CASE TestCase OF]]>
</Line>
<Line Number="13">
<![CDATA[		1: //At position 0]]>
</Line>
<Line Number="14">
<![CDATA[			Command := 0;]]>
</Line>
<Line Number="15">
<![CDATA[			Sensor0 := 1;]]>
</Line>
<Line Number="16">
<![CDATA[			Sensor1 := 0;]]>
</Line>
<Line Number="17">
<![CDATA[			TestDeactivate := 0;]]>
</Line>
<Line Number="18">
<![CDATA[			Timeout0 := 100;]]>
</Line>
<Line Number="19">
<![CDATA[			Timeout1 := 100;]]>
</Line>
<Line Number="20">
<![CDATA[		2: //Move to position 1]]>
</Line>
<Line Number="21">
<![CDATA[			Command := 1;]]>
</Line>
<Line Number="22">
<![CDATA[			Sensor0 := 1;]]>
</Line>
<Line Number="23">
<![CDATA[			Sensor1 := 0;]]>
</Line>
<Line Number="24">
<![CDATA[			TestDeactivate := 0;]]>
</Line>
<Line Number="25">
<![CDATA[			Timeout0 := 100;]]>
</Line>
<Line Number="26">
<![CDATA[			Timeout1 := 100;]]>
</Line>
<Line Number="27">
<![CDATA[		3: //Timeout]]>
</Line>
<Line Number="28">
<![CDATA[			Command := 0;]]>
</Line>
<Line Number="29">
<![CDATA[			Sensor0 := 0;]]>
</Line>
<Line Number="30">
<![CDATA[			Sensor1 := 1;]]>
</Line>
<Line Number="31">
<![CDATA[			TestDeactivate := 0;]]>
</Line>
<Line Number="32">
<![CDATA[			Timeout0 := 100;]]>
</Line>
<Line Number="33">
<![CDATA[			Timeout1 := 100;]]>
</Line>
<Line Number="34">
<![CDATA[		4: //Timeout, Deactivate on Fault]]>
</Line>
<Line Number="35">
<![CDATA[			Command := 0;]]>
</Line>
<Line Number="36">
<![CDATA[			Sensor0 := 0;]]>
</Line>
<Line Number="37">
