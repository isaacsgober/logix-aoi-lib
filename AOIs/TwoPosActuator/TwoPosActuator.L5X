<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--Two-position actuator monitor that confirms the commanded position from end-of-travel sensors, with a timeout fault and a sensor conflict fault.-->
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="36.03" TargetName="TwoPosActuator" TargetType="AddOnInstructionDefinition" TargetRevision="1.0 " TargetLastEdited="2026-11-19T18:42:30.305Z" ContainsContext="true" ExportDate="Thu Nov 19 17:49:15 2026" ExportOptions="References NoRawData L5KData DecoratedData Context Dependencies ForceProtectedEncoding AllProjDocTrans">
<Controller Use="Context" Name="AOI_Test">
<DataTypes Use="Context">
</DataTypes>
<AddOnInstructionDefinitions Use="Context">
<AddOnInstructionDefinition Use="Target" Name="TwoPosActuator" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2026-11-19T17:25:57.442Z" CreatedBy="ICCMS\igober01" EditedDate="2026-11-19T18:42:30.305Z" EditedBy="ICCMS\igober01" SoftwareRevision="v36.03"
>
<Description>
<![CDATA[Two-position actuator monitor that confirms the commanded position from end-of-travel sensors, with a timeout fault and a sensor conflict fault.]]>
</Description>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="DriveType" TagType="Base" DataType="INT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[0 = one drive, returns to position 0 when off (single-solenoid spring return). 1 = two drives, holds when both off (double-solenoid detented). 2 = two drives, stops when both off (three-position center).]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="DeactivateOnFault" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[If true, any fault sets Drive0 and Drive1 false. If false, Drive0 and Drive1 hold their respective last states.]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Cmd" TagType="Base" DataType="INT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[0 = go to position 0, 1 = go to position 1, 2 = stop (DriveType 2 only).]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Pos0Sensor" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Sensor at position 0.]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="TimeoutTo0" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Time allowed to reach position 0 after Cmd becomes 0 (ms).]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Pos1Sensor" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Sensor at position 1.]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="TimeoutTo1" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Time allowed to reach position 1 after Cmd becomes 1 (ms).]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Reset" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Clears latched faults.]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Drive0" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[On when Cmd is 0. Off when any fault is latched if DeactivateOnFault is true.]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Drive1" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[On when Cmd is 1. Off when any fault is latched if DeactivateOnFault is true.]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="AtPos0" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Cmd is 0, Pos0Sensor is on, and Pos1Sensor is off.]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="AtPos1" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Cmd is 1, Pos1Sensor is on, and Pos0Sensor is off.]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="TimeoutFault" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Commanded position not reached in time. Latched until Reset.]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="SensorFault" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Both sensors on at once. Latched until Reset.]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="ParamFault" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Cmd DriveType, or Timeout out of range, or Cmd 2 with DriveType 0 or 1. Latched until Reset.]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="CmdStorage" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="MoveTimer" DataType="FBD_TIMER" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[1,0,0,0,0,0,0,0,0,4,0,0]]]>
</DefaultData>
<DefaultData Format="Decorated">
<Structure DataType="FBD_TIMER">
<DataValueMember Name="EnableIn" DataType="BOOL" Value="1"/>
<DataValueMember Name="TimerEnable" DataType="BOOL" Value="0"/>
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Reset" DataType="BOOL" Value="0"/>
<DataValueMember Name="EnableOut" DataType="BOOL" Value="0"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
<DataValueMember Name="Status" DataType="DINT" Radix="Hex" Value="16#0000_0000"/>
<DataValueMember Name="InstructFault" DataType="BOOL" Value="0"/>
<DataValueMember Name="PresetInv" DataType="BOOL" Value="0"/>
</Structure>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<Description>
<![CDATA[Two-position actuator monitor that confirms the commanded position from end-of-travel sensors, with a timeout fault and a sensor conflict fault.]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[IF Reset THEN]]>
</Line>
<Line Number="1">
<![CDATA[	ParamFault := 0;]]>
</Line>
<Line Number="2">
<![CDATA[	SensorFault := 0;]]>
</Line>
<Line Number="3">
<![CDATA[	TimeoutFault := 0;]]>
</Line>
<Line Number="4">
<![CDATA[END_IF;]]>
</Line>
<Line Number="5">
<![CDATA[AtPos0 := ((Cmd = 0) AND Pos0Sensor AND NOT Pos1Sensor);]]>
</Line>
<Line Number="6">
<![CDATA[AtPos1 := ((Cmd = 1) AND Pos1Sensor AND NOT Pos0Sensor);]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[CASE Cmd OF]]>
</Line>
<Line Number="9">
<![CDATA[	0:]]>
</Line>
<Line Number="10">
<![CDATA[		MoveTimer.PRE := TimeoutTo0;]]>
</Line>
<Line Number="11">
<![CDATA[	1:]]>
</Line>
<Line Number="12">
<![CDATA[		MoveTimer.PRE := TimeoutTo1;]]>
</Line>
<Line Number="13">
<![CDATA[END_CASE;]]>
</Line>
<Line Number="14">
<![CDATA[MoveTimer.TimerEnable := (((Cmd = 0) AND NOT AtPos0) OR ((Cmd = 1) AND NOT AtPos1));]]>
</Line>
<Line Number="15">
<![CDATA[MoveTimer.Reset := ((Cmd <> CmdStorage) OR Reset);]]>
</Line>
<Line Number="16">
<![CDATA[TONR(MoveTimer);]]>
</Line>
<Line Number="17">
<![CDATA[]]>
</Line>
<Line Number="18">
<![CDATA[IF MoveTimer.DN THEN]]>
</Line>
<Line Number="19">
<![CDATA[	TimeoutFault := 1;]]>
</Line>
<Line Number="20">
<![CDATA[END_IF;]]>
</Line>
<Line Number="21">
<![CDATA[IF ((DriveType < 0) OR (DriveType > 2) OR (Cmd < 0) OR (Cmd > 2) OR ((Cmd = 2) AND DriveType <> 2) OR (TimeoutTo0 < 0) OR (TimeoutTo1 < 0)) THEN]]>
</Line>
<Line Number="22">
<![CDATA[	ParamFault := 1;]]>
</Line>
<Line Number="23">
<![CDATA[END_IF;]]>
</Line>
<Line Number="24">
<![CDATA[IF (Pos0Sensor AND Pos1Sensor) THEN]]>
</Line>
<Line Number="25">
<![CDATA[	SensorFault := 1;]]>
</Line>
<Line Number="26">
<![CDATA[END_IF;]]>
</Line>
<Line Number="27">
<![CDATA[]]>
</Line>
<Line Number="28">
<![CDATA[Drive0 := (Cmd = 0);]]>
</Line>
<Line Number="29">
<![CDATA[Drive1 := (Cmd = 1);]]>
</Line>
<Line Number="30">
<![CDATA[IF ((ParamFault OR SensorFault OR TimeoutFault) AND DeactivateOnFault) THEN]]>
</Line>
<Line Number="31">
<![CDATA[	Drive0 := 0;]]>
</Line>
<Line Number="32">
<![CDATA[	Drive1 := 0;]]>
</Line>
<Line Number="33">
<![CDATA[END_IF;]]>
</Line>
<Line Number="34">
<![CDATA[]]>
</Line>
<Line Number="35">
<![CDATA[CmdStorage := Cmd;]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
</Controller>
</RSLogix5000Content>
